//@version=6
indicator('Range Indicator Golden Pocket, Liquidity, FairValueGaps, TrendReversal', overlay = true, max_lines_count = 500, max_boxes_count = 500)

// --- 1. SETTINGS: RANGE & GP ---
i_boxColor = input.color(color.new(#787b86, 92), 'Range Background', group = 'Range Visuals')
i_gpBullishColor = input.color(color.new(#4caf50, 60), 'Bullish GP Color', group = 'Range Visuals')
i_gpBearishColor = input.color(color.new(#f44336, 60), 'Bearish GP Color', group = 'Range Visuals')
i_liqColor = input.color(color.new(#ffeb3b, 85), 'Liquidity Zones Color', group = 'Range Visuals')
i_lineColor = input.color(color.white, 'Boundary Line Color', group = 'Range Visuals')
i_whiteText = color.white

// Session & Anchor Settings (NEW)
grp_sess = "Session & Anchor Settings"
i_sessRange   = input.session("2000-0000", "Range Capture Session (e.g., Asia)", group=grp_sess)
i_midnight    = input.int(0, "Midnight Hour (EST)", minval=0, maxval=23, group=grp_sess)
i_timezone    = input.string("America/New_York", "Timezone", group=grp_sess)

// Smart Filters (NEW)
grp_filt = "Smart Filters (ATR/ADX)"
i_useFilters  = input.bool(true, "Enable Smart Filters", group=grp_filt)
i_adxThresh   = input.int(25, "Trend Strength Threshold (ADX)", minval = 1, maxval = 50, group=grp_filt)
i_volMult     = input.float(1.5, "Min Range Volatility (ATR Mult)", step=0.1, group=grp_filt)
i_sweepMult   = input.float(0.5, "Max Sweep Depth (ATR Mult)", step=0.1, group=grp_filt)

// Volume Settings
grp_vol = "Volume Pivots & Logic"
i_volLen      = input.int(20, "Volume Lookback", group=grp_vol)
i_volThreshMult = input.float(1.5, "High Volume Threshold (x Avg)", step=0.1, group=grp_vol)

i_offsetR = input.int(50, 'Box Offset Right', minval = 0, group = 'Range Visuals')

// FVG Settings
i_showFVG = input.bool(true, 'Show Fair Value Gaps (FVG)', group = 'FVG Settings')
i_fvgLen = input.int(10, 'FVG Extension (Bars)', minval = 1, group = 'FVG Settings')
i_bullFVGColor = input.color(color.new(#4caf50, 80), 'Bullish FVG Color', group = 'FVG Settings')
i_bearFVGColor = input.color(color.new(#f44336, 80), 'Bearish FVG Color', group = 'FVG Settings')
i_showLabels = input.bool(true, 'Show Price Lines & Labels', group = 'Range Visuals')

// --- 2. SETTINGS: TREND RIBBON ---
g_trend = 'Trend Ribbon Settings'
i_showTrend = input.bool(false, 'Enable Trend Ribbon', group = g_trend)
i_maType = input.string('EMA', 'MA Type', ['ALMA', 'HMA', 'SMA', 'SWMA', 'VWMA', 'WMA', 'ZLEMA', 'EMA'], group = g_trend)
i_maPeriod = input.int(9, 'MA Period (Length)', 1, group = g_trend)
i_almaOffset = input.float(0.85, 'ALMA Shift', 0, 1, 0.05, group = g_trend)
i_almaSigma = input.int(6, 'ALMA Deviation', 1, group = g_trend)

i_showCloseLine = input.bool(true, 'Show Trend Close Line', group = g_trend)
i_showHiLoLines = input.bool(false, 'Show Trend High/Low Lines', group = g_trend)
i_showTrendFill = input.bool(true, 'Show Trend Cloud Fill', group = g_trend)

i_trendBull = input.color(color.new(#26A69A, 0), 'Trend Bullish Color', group = g_trend)
i_trendBear = input.color(color.new(#EF5350, 0), 'Trend Bearish Color', group = g_trend)
i_trendNeut = input.color(color.new(#808080, 0), 'Trend Neutral Color', group = g_trend)

// --- 3. DIVERGENCE CALCULATIONS ---
rsiVal = ta.rsi(close, 14)
[macdLine, _, _] = ta.macd(close, 12, 26, 9)
p_lb = 5
pl = ta.pivotlow(low, p_lb, p_lb)
ph = ta.pivothigh(high, p_lb, p_lb)

// Refactored to avoid runtime error from ta.valuewhen offset
// We need to compare Current Pivot vs Previous Pivot.
var float prev_rsi_pl = na
var float prev_low_pl = na
var float prev_macd_pl = na

var float prev_rsi_ph = na
var float prev_high_ph = na
var float prev_macd_ph = na

// Check Divergence BEFORE updating the "Previous" variables with the "Current" values
rsiBull = not na(pl) and rsiVal[p_lb] > prev_rsi_pl and low[p_lb] < prev_low_pl
macdBull = not na(pl) and macdLine[p_lb] > prev_macd_pl and low[p_lb] < prev_low_pl
rsiBear = not na(ph) and rsiVal[p_lb] < prev_rsi_ph and high[p_lb] > prev_high_ph
macdBear = not na(ph) and macdLine[p_lb] < prev_macd_ph and high[p_lb] > prev_high_ph

if not na(pl)
    prev_rsi_pl := rsiVal[p_lb]
    prev_low_pl := low[p_lb]
    prev_macd_pl := macdLine[p_lb]

if not na(ph)
    prev_rsi_ph := rsiVal[p_lb]
    prev_high_ph := high[p_lb]
    prev_macd_ph := macdLine[p_lb]

string statusText = 'LIQUIDITY'
if rsiBull or macdBull
    statusText := 'LIQUIDITY | BULL DIV: ' + (rsiBull ? 'RSI ' : '') + (macdBull ? 'MACD' : '')
    statusText
else if rsiBear or macdBear
    statusText := 'LIQUIDITY | BEAR DIV: ' + (rsiBear ? 'RSI ' : '') + (macdBear ? 'MACD' : '')
    statusText

// --- 4. SMART LOGIC: SESSION, REGIME & MSS ---
// ADX & ATR
[diPlus, diMinus, adx] = ta.dmi(14, 14)
atr = ta.atr(14)
isTrending = i_useFilters and adx > i_adxThresh
isRanging  = not isTrending

// Volume Logic
avgVol = ta.sma(volume, i_volLen)
isHighVol = volume > avgVol * i_volThreshMult
isLowVol  = volume < avgVol * 0.5

// Session Logic (Anchored)
inSession = not na(time(timeframe.period, i_sessRange, i_timezone))
newSess = inSession and not inSession[1]

var float sHigh = na
var float sLow  = na
var float midnightOpen = na

// Midnight Open
if hour(time, i_timezone) == i_midnight and minute(time, i_timezone) == 0
    midnightOpen := open

// Capture Session Extremes
if newSess
    sHigh := high
    sLow  := low
else if inSession
    sHigh := math.max(high, sHigh)
    sLow  := math.min(low, sLow)

// Anchor Bar for Visuals
var int anchorBar = na
if newSess
    anchorBar := bar_index

// Range & Golden Pocket Calcs (Mapped to old variables)
rHigh = sHigh
rLow  = sLow
float rDiff = rHigh - rLow
float bUp = rLow + rDiff * 0.382
float bLo = rLow + rDiff * 0.35
float sUp = rHigh - rDiff * 0.35
float sLo = rHigh - rDiff * 0.382

// Volatility Check
isTradeable = rDiff > (atr * i_volMult)

// Market Structure Shift (MSS) Swing Points
var float swL = na
var float swH = na
if low[1] < low[0] and low[1] < low[2]
    swL := low[1]
if high[1] > high[0] and high[1] > high[2]
    swH := high[1]

// High Volume Pivots (Wyckoff "Effort")
var float volSwH = na
var float volSwL = na
if not na(ta.pivothigh(high, 2, 2)) and isHighVol[2]
    volSwH := high[2]
if not na(ta.pivotlow(low, 2, 2)) and isHighVol[2]
    volSwL := low[2]

// --- 5. CALCULATIONS: TREND RIBBON ---
f_ma(x, type, len, off, sig) =>
    switch type
        'ALMA' => ta.alma(x, len, off, sig)
        'HMA' => ta.hma(x, len)
        'SMA' => ta.sma(x, len)
        'SWMA' => ta.swma(x)
        'VWMA' => ta.vwma(x, len)
        'WMA' => ta.wma(x, len)
        'ZLEMA' => ta.ema(x + x - x[math.floor((len - 1) / 2)], len)
        => ta.ema(x, len)

haTicker = ticker.heikinashi(syminfo.tickerid)
haOpen = request.security(haTicker, timeframe.period, open)
haClose = request.security(haTicker, timeframe.period, close)
haHigh = request.security(haTicker, timeframe.period, high)
haLow = request.security(haTicker, timeframe.period, low)

ma_ha_open = f_ma(haOpen, i_maType, i_maPeriod, i_almaOffset, i_almaSigma)
ma_ha_close = f_ma(haClose, i_maType, i_maPeriod, i_almaOffset, i_almaSigma)
ma_ha_high = f_ma(haHigh, i_maType, i_maPeriod, i_almaOffset, i_almaSigma)
ma_ha_low = f_ma(haLow, i_maType, i_maPeriod, i_almaOffset, i_almaSigma)

trend_val = 100 * (ma_ha_close - ma_ha_open) / (ma_ha_high - ma_ha_low)
color_trend = trend_val > 0 ? i_trendBull : i_trendBear
trend_bullish = trend_val > 0
trend_flip_bull = trend_bullish and not trend_bullish[1]
trend_flip_bear = not trend_bullish and trend_bullish[1]

// --- 6. FVG LOGIC ---
if i_showFVG
    if low > high[2]
        box.new(bar_index[1], low, bar_index + i_fvgLen, high[2], bgcolor = i_bullFVGColor, border_color = na)
    if high < low[2]
        box.new(bar_index[1], high, bar_index + i_fvgLen, low[2], bgcolor = i_bearFVGColor, border_color = na)

// --- 7. VISUALS: RANGE & LABELS ---
var box b_Range = box.new(na, na, na, na, xloc = xloc.bar_index, bgcolor = i_boxColor, border_color = color.gray)
var box b_Bullish = box.new(na, na, na, na, xloc = xloc.bar_index, bgcolor = i_gpBullishColor, border_color = na, text = 'BULLISH Golden Pocket ↑', text_color = color.white, text_size = size.small)
var box b_Bearish = box.new(na, na, na, na, xloc = xloc.bar_index, bgcolor = i_gpBearishColor, border_color = na, text = 'BEARISH Golden Pocket ↓', text_color = color.white, text_size = size.small)
var box b_LiqTop = box.new(na, na, na, na, xloc = xloc.bar_index, bgcolor = i_liqColor, border_color = na, text = 'LIQUIDITY', text_color = i_whiteText, text_size = size.tiny)
var box b_LiqBot = box.new(na, na, na, na, xloc = xloc.bar_index, bgcolor = i_liqColor, border_color = na, text = 'LIQUIDITY', text_color = i_whiteText, text_size = size.tiny)

var array<line> l_levels = array.new_line()
var array<label> lb_prices = array.new_label()

// Dashboard Table
var table dash = table.new(position.top_right, 2, 3, bgcolor=color.new(color.black, 50), border_color=color.gray, border_width=1)

if barstate.isfirst
    for i = 0 to 7 by 1
        array.push(l_levels, line.new(na, na, na, na, xloc = xloc.bar_index, color = i_lineColor))
        array.push(lb_prices, label.new(na, na, '', xloc = xloc.bar_index, color = color.new(color.black, 100), textcolor = i_lineColor, size = size.small, style = label.style_label_left))

if barstate.islast and not na(anchorBar)
    int rightBar = bar_index + i_offsetR

    // Regime Visibility (Dim if Trending)
    color rangeBg = isTrending ? color.new(i_boxColor, 100) : i_boxColor
    color gpBullBg = isTrending ? color.new(i_gpBullishColor, 100) : i_gpBullishColor
    color gpBearBg = isTrending ? color.new(i_gpBearishColor, 100) : i_gpBearishColor

    box.set_lefttop(b_Range, anchorBar, rHigh)
    box.set_rightbottom(b_Range, rightBar, rLow)
    box.set_bgcolor(b_Range, rangeBg)

    box.set_lefttop(b_Bullish, anchorBar, bUp)
    box.set_rightbottom(b_Bullish, rightBar, bLo)
    box.set_bgcolor(b_Bullish, gpBullBg)

    box.set_lefttop(b_Bearish, anchorBar, sUp)
    box.set_rightbottom(b_Bearish, rightBar, sLo)
    box.set_bgcolor(b_Bearish, gpBearBg)

    box.set_lefttop(b_LiqTop, anchorBar, rHigh)
    box.set_rightbottom(b_LiqTop, rightBar, rHigh - rDiff * 0.05)

    box.set_lefttop(b_LiqBot, anchorBar, rLow + rDiff * 0.05)
    box.set_rightbottom(b_LiqBot, rightBar, rLow)
    box.set_text(b_LiqBot, statusText)

    if i_showLabels
        array<float> p_vals = array.from(rHigh, rHigh - rDiff * 0.05, sUp, sLo, bUp, bLo, rLow + rDiff * 0.05, rLow)
        for i = 0 to 7 by 1
            float v = array.get(p_vals, i)
            line.set_xy1(array.get(l_levels, i), anchorBar, v)
            line.set_xy2(array.get(l_levels, i), rightBar, v)
            label.set_xy(array.get(lb_prices, i), rightBar, v)
            label.set_text(array.get(lb_prices, i), ' ' + str.tostring(v, format.mintick))

    // Dashboard Update
    table.cell(dash, 0, 0, "Regime", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, isTrending ? "TRENDING" : "RANGING", text_color=isTrending ? color.orange : color.lime, text_size=size.small)
    table.cell(dash, 0, 1, "Volatility", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, isTradeable ? "TRADEABLE" : "CHOP", text_color=isTradeable ? color.lime : color.red, text_size=size.small)
    table.cell(dash, 0, 2, "Volume", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, isHighVol ? "CLIMAX" : isLowVol ? "LOW" : "NORMAL", text_color=isHighVol ? color.red : isLowVol ? color.blue : color.gray, text_size=size.small)

// Midnight Open Plot
plot(midnightOpen, "Midnight Open", color.new(color.white, 50), 1, plot.style_stepline)

// --- 8. VISUALS: TREND RIBBON PLOTS ---
plot_open = plot(i_showTrend ? ma_ha_open : na, 'Trend Open', na)
plot_close = plot(i_showTrend ? ma_ha_close : na, 'Trend Close', i_showCloseLine ? color_trend : na, 2)
plot_high = plot(i_showTrend ? ma_ha_high : na, 'Trend High', i_showHiLoLines ? i_trendNeut : na)
plot_low = plot(i_showTrend ? ma_ha_low : na, 'Trend Low', i_showHiLoLines ? i_trendNeut : na)

plot_body_h = plot(i_showTrend ? math.max(ma_ha_open, ma_ha_close) : na, 'Body High', na)
plot_body_l = plot(i_showTrend ? math.min(ma_ha_open, ma_ha_close) : na, 'Body Low', na)

fill(plot_open, plot_close, i_showTrend and i_showTrendFill ? color.new(color_trend, 50) : na, 'Main Ribbon Fill')
fill(plot_high, plot_body_h, i_showTrend and i_showTrendFill ? color.new(i_trendNeut, 87) : na, 'Upper Wick Fill')
fill(plot_body_l, plot_low, i_showTrend and i_showTrendFill ? color.new(i_trendNeut, 87) : na, 'Lower Wick Fill')

// --- 9. SIGNAL LOGIC & ALERTS ---
// Kill Zones for SFP
upperKillZone = rHigh + (atr * i_sweepMult)
lowerKillZone = rLow - (atr * i_sweepMult)

// Smart SFP Logic (Filtered by Session, Volatility, Regime & Volume)
// Avoid SFP on Climax Volume (Breakout Traps)
bool sfpShort = high > rHigh and high < upperKillZone and close < rHigh and not inSession and isTradeable and isRanging and not isHighVol
bool sfpLong  = low < rLow and low > lowerKillZone and close > rLow and not inSession and isTradeable and isRanging and not isHighVol

// MSS Logic (Break of Structure after SFP)
// Require Displacement (Volume > Avg) on the break
bool xSwL = ta.crossunder(close, swL) and volume > avgVol
bool xSwH = ta.crossover(close, swH) and volume > avgVol
bool mssShort = ta.barssince(sfpShort) < 5 and xSwL
bool mssLong  = ta.barssince(sfpLong) < 5 and xSwH

// Legacy Trend/GP Logic
var bool tBear = false
var bool tBull = false
if high >= sLo and low <= sUp
    tBear := true
if low <= bUp and high >= bLo
    tBull := true

// Candle Patterns (3-bar reversal)
bool pL = close[2] < open[2] and close[1] > open[1] and close > high[1]
bool pS = close[2] > open[2] and close[1] < open[1] and close < low[1]

bool gpPatternLong  = tBull and pL and isTradeable and isRanging
bool gpPatternShort = tBear and pS and isTradeable and isRanging

// Reset State on break
if gpPatternShort or tBear and high > rHigh
    tBear := false
if gpPatternLong or tBull and low < rLow
    tBull := false

bool xGPBear = ta.crossover(high, sLo)
bool xGPBull = ta.crossunder(low, bUp)
alertcondition(xGPBear or xGPBull, 'GP Touch', 'Price entered Golden Pocket.')
alertcondition(gpPatternLong, 'Long Pattern (GP)', 'Long Reversal Pattern in Bullish GP.')
alertcondition(gpPatternShort, 'Short Pattern (GP)', 'Short Reversal Pattern in Bearish GP.')
alertcondition(sfpLong, 'SFP Long (Smart)', 'Liquidity Sweep at Session Low (Volatility Filtered).')
alertcondition(sfpShort, 'SFP Short (Smart)', 'Liquidity Sweep at Session High (Volatility Filtered).')
alertcondition(mssLong, 'MSS Long', 'Market Structure Shift Long confirmed.')
alertcondition(mssShort, 'MSS Short', 'Market Structure Shift Short confirmed.')

// Signal Visuals
plotshape(sfpShort, "SFP Short", shape.triangledown, location.abovebar, color.red, size=size.tiny, text="SFP")
plotshape(sfpLong, "SFP Long", shape.triangleup, location.belowbar, color.green, size=size.tiny, text="SFP")
plotshape(mssShort, "MSS Short", shape.labeldown, location.abovebar, color.red, size=size.tiny, text="MSS", textcolor=color.white)
plotshape(mssLong, "MSS Long", shape.labelup, location.belowbar, color.green, size=size.tiny, text="MSS", textcolor=color.white)

// --- 10. TOOLBOX ALERTS (Trend & Divergence) ---
alertcondition(ta.cross(close, ma_ha_close), 'Cross: Price & Trend Line', 'Price has crossed the Trend Signal Line')
alertcondition(ta.crossover(high, rHigh - rDiff * 0.05), 'Cross: Enter Upper Liquidity', 'Price entered Upper Liquidity Zone')
alertcondition(ta.crossunder(low, rLow + rDiff * 0.05), 'Cross: Enter Lower Liquidity', 'Price entered Lower Liquidity Zone')
alertcondition(trend_flip_bull, 'Trend: Bullish Flip', 'Trend Ribbon flipped BULLISH')
alertcondition(trend_flip_bear, 'Trend: Bearish Flip', 'Trend Ribbon flipped BEARISH')
alertcondition(rsiBull, 'Div: RSI Bullish', 'RSI Bullish Divergence detected')
alertcondition(rsiBear, 'Div: RSI Bearish', 'RSI Bearish Divergence detected')
alertcondition(macdBull, 'Div: MACD Bullish', 'MACD Bullish Divergence detected')
alertcondition(macdBear, 'Div: MACD Bearish', 'MACD Bearish Divergence detected')
alertcondition(rsiBull and macdBull, 'Confluence: Both Bullish Div', 'RSI & MACD Bullish Divergence detected')
alertcondition(rsiBear and macdBear, 'Confluence: Both Bearish Div', 'RSI & MACD Bearish Divergence detected')
